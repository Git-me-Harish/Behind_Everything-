{
  "name": "behind-everything",
  "version": "0.1.0",
  "description": "See what your AI coding agent is actually doing: a live, local-first 3D view of Claude Code, Codex and GitHub Copilot CLI sessions.",
  "keywords": [
    "claude-code",
    "codex",
    "copilot",
    "ai-agents",
    "observability",
    "visualizer",
    "developer-tools",
    "local-first"
  ],
  "homepage": "https://git-me-harish.github.io/Behind_Everything-/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Git-me-Harish/Behind_Everything-.git"
  },
  "bugs": {
    "url": "https://github.com/Git-me-Harish/Behind_Everything-/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "behind-everything": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "pnpm build:web && tsx src/cli.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "tsc -p tsconfig.build.json && pnpm build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p test/web && tsc --noEmit -p e2e && tsc --noEmit -p site",
    "test": "vitest run",
    "test:local": "BE_LOCAL_TRANSCRIPTS=1 vitest run test/local-transcripts.test.ts",
    "hooks": "tsx src/cli.ts hooks",
    "test:e2e": "pnpm build:web && playwright test",
    "prepublishOnly": "pnpm build",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "site:assets": "tsx scripts/site-assets.ts",
    "test:site": "playwright test --config playwright.site.config.ts",
    "site": "pnpm site:build && pnpm site:preview"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
