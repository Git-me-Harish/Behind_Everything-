{
  "name": "behind-everything",
  "version": "0.1.0",
  "description": "Live, local-first visualizer of what AI coding agents actually do.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "behind-everything": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "pnpm build:web && tsx src/cli.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "tsc -p tsconfig.build.json && pnpm build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p test/web && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:local": "BE_LOCAL_TRANSCRIPTS=1 vitest run test/local-transcripts.test.ts",
    "test:e2e": "pnpm build:web && playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
